# Provider API keys are entered by users at runtime in the browser.
# They are stored only in React state / sessionStorage unless a scheduled job is created.

# Required for Supabase-backed workflow features.
# Core agent runs work without these values.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required for the /api/cron/tick endpoint (server-side only, never prefix with VITE_).
# Requests are rejected unless they send "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=your_cron_secret
